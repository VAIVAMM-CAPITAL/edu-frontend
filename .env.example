# Phantom King frontend configuration. Copy to frontend/.env and fill in.

# Backend API (the NestJS server). Browser calls go through this site's /api proxy.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production example: NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Public origin of this site, used for canonical URLs, social metadata and payment return pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public support email shown on the Contact page and error screens (leave empty to hide).
NEXT_PUBLIC_CONTACT_EMAIL=

# Prices and payment gateways are per country and come from the backend:
#   US (USD), UK (GBP), UAE (AED) -> Stripe;  India (INR) -> Razorpay.
# The visitor's country is detected from the host's location header
# (Vercel x-vercel-ip-country or Cloudflare cf-ipcountry) and can be changed
# with the country selector in the header. No payment keys belong here.

# Currency label used in the instructor course editor's single price field (the UAE price).
NEXT_PUBLIC_PLATFORM_CURRENCY=AED
